{
  "name": "root",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "22 || 24"
  },
  "scripts": {
    "start": "backstage-cli repo start",
    "build:backend": "yarn workspace backend build",
    "build:all": "backstage-cli repo build --all",
    "build-image": "yarn workspace backend build-image",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false",
    "clean": "backstage-cli repo clean",
    "test": "backstage-cli repo test",
    "test:all": "backstage-cli repo test --coverage",
    "test:e2e": "playwright test",
    "fix": "backstage-cli repo fix",
    "lint": "backstage-cli repo lint --since origin/main",
    "lint:all": "backstage-cli repo lint",
    "prettier:check": "prettier --check .",
    "new": "backstage-cli new"
  },
  "backstage": {
    "cli": {
      "new": {
        "globals": {
          "license": "UNLICENSED"
        }
      }
    }
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.36.7",
    "@backstage/cli-defaults": "^0.1.7",
    "@backstage/e2e-test-utils": "^0.1.2",
    "@jest/environment-jsdom-abstract": "~30.4.1",
    "@playwright/test": "^1.61.1",
    "@types/jest": "^30.0.0",
    "jest": "~30.4.2",
    "jsdom": "^29.1.1",
    "node-gyp": "^10.0.0",
    "prettier": "^2.3.2",
    "typescript": "~6.0.3"
  },
  "resolutions": {
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "protobufjs": "7.6.5",
    "tar": "7.5.22",
    "dompurify": "3.4.17",
    "@azure/msal-node": "^7.1.0",
    "@graphql-tools/utils": "^12.1.0",
    "basic-ftp": "^6.2.2",
    "@module-federation/dts-plugin/undici": "^7.30.1",
    "refractor/prismjs": "^1.30.0",
    "postcss-selector-parser": "^7.1.6",
    "dockerode/uuid": "^11.1.1",
    "gaxios/uuid": "^11.1.1",
    "google-gax/uuid": "^11.1.1",
    "mockttp/uuid": "^11.1.1",
    "sockjs/uuid": "^11.1.1",
    "teeny-request/uuid": "^11.1.1"
  },
  "prettier": "@backstage/cli/config/prettier",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.13.0"
}
